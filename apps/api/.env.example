NODE_ENV=development
PORT=4000

# CORS - comma-separated allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Supabase (get from supabase.com dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Clerk (get from clerk.com dashboard)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Daily challenge seed secret (generate with: openssl rand -hex 32)
DAILY_SEED_SECRET=change-this-to-a-64-char-hex-string-for-production

# Score validation secret (must match frontend build-time secret)
SCORE_SECRET=abyssal-client-hash
