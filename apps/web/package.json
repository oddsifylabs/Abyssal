  },
  "dependencies": {
    "@abyssal/types": "workspace:*",
    "@clerk/clerk-js": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0"
  }
}
